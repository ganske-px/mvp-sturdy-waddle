# =====================================================
# Supabase
# =====================================================
# After `pnpm exec supabase start`, copy the values from
# the printed status block into a `.env.local` (never commit).

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# =====================================================
# Predictus API (shared service credentials)
# =====================================================

PREDICTUS_BASE_URL=https://api.predictus.com.br
PREDICTUS_USERNAME=
PREDICTUS_PASSWORD=

# =====================================================
# Netrin API (consulta-composta)
# =====================================================
NETRIN_BASE_URL=https://api.netrin.com.br
NETRIN_TOKEN=your_static_token_here
NETRIN_PEP_ACURACIA=95
